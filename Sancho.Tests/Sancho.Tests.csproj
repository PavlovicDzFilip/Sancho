<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit.v3" Version="3.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sancho.Console\Sancho.Console.csproj" />
        <ProjectReference Include="..\Sancho.ProcessTestHost\Sancho.ProcessTestHost.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="CopyProcessTestHost" AfterTargets="Build">
        <ItemGroup>
            <ProcessTestHostFiles Include="..\Sancho.ProcessTestHost\bin\$(Configuration)\net10.0\Sancho.ProcessTestHost.*" />
        </ItemGroup>
        <Copy SourceFiles="@(ProcessTestHostFiles)" DestinationFolder="$(OutDir)process-test-host" />
    </Target>

    <ItemGroup>
        <None Update="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
